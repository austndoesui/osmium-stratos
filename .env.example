# Security Configuration
NODE_ENV=development

# Database
DATABASE_URL=postgres://Quantarauser:***@us-east4-001.proxy.kinsta.app:30173/Quantaradash

# Session & JWT
JWT_SECRET=replace-this-with-a-very-long-random-secret-key-in-production
SESSION_SECRET=replace-this-with-another-very-long-random-secret-key

# Security Headers
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Development Settings (disable in production)
TRUST_PROXY=true
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Server
PORT=3000
HOST=localhost